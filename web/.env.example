# ==============================================================================
# MediVault HMS & EHR - Environment Configuration Template (.env.example)
# Copy this file to .env.local and fill in your actual infrastructure values.
# NEVER commit your real .env.local or production secrets to Git.
# ==============================================================================

# Database Connection (PostgreSQL Pooler)
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_database_user
DB_PASSWORD=your_database_password_here

# Cryptographic Key Derivation (NIST SP 800-63B Argon2id + HMAC-SHA256 Pepper)
PEPPER_V1=your_256_bit_server_pepper_here

# Session Management (JWT Signing Key)
JWT_SECRET=your_jwt_signing_secret_here

# Runtime Environment
NODE_ENV=development
